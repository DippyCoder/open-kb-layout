{
  "name": "open-kb-layout",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:store": "wrangler dev -c worker/wrangler.toml --port 8789",
    "dev:api": "wrangler pages dev dist --port 8788",
    "build": "vite build",
    "preview": "npm run build && wrangler pages dev dist --port 8788",
    "typecheck": "tsc --noEmit",
    "deploy:store": "wrangler deploy -c worker/wrangler.toml",
    "deploy": "npm run deploy:store && npm run build && wrangler pages deploy dist"
  },
  "dependencies": {
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "smol-toml": "^1.9.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261121.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wrangler": "^4.166.0"
  }
}
